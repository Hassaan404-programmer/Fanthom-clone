{
  "agent-capture-hook": {
    "PostInvocation": [
      {
        "type": "command",
        "command": "python scripts/antigravity_capture.py"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python scripts/antigravity_capture.py"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/antigravity_capture.py"
          }
        ]
      }
    ]
  }
}
